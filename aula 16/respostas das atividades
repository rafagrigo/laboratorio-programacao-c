Questão 5:

#include <stdio.h>

int main(void) {
    char palavra[30];
    int vogais = 0;

    printf("Digite uma palavra (em letras minusculas): ");
    scanf("%29s", palavra);

    for (int i = 0; palavra[i] != '\0'; i++) {
        char c = palavra[i];
        if (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u') {
            vogais++;
        }
    }

    printf("A palavra possui %d vogais minusculas.\n", vogais);

    return 0;
}

