#include <stdio.h>

typedef struct {
    char nome[50];
    float salario;
    int horasExtras;
} Funcionario;

int main(void) {
    FILE *arquivo;
    Funcionario f;
    int opcao;
    int caractere;
    int i;

    do {
        printf("\n===== CADASTRO DE FUNCIONARIOS =====\n");
        printf("1 - Cadastrar ate 5 funcionarios\n");
        printf("2 - Visualizar funcionarios\n");
        printf("0 - Sair\n");
        printf("Escolha uma opcao: ");

        if (scanf("%d", &opcao) != 1) {
            printf("Opcao invalida!\n");
            return 1;
        }

        if (opcao == 1) {
            arquivo = fopen("funcionarios.txt", "a");
            if (arquivo == NULL) {
                perror("Erro ao abrir arquivo");
                continue;
            }

            for (i = 0; i < 5; i++) {
                printf("\n--- Funcionario %d ---\n", i + 1);
                printf("Nome: ");
                scanf(" %49[^\n]", f.nome);
                printf("Salario: ");
                scanf("%f", &f.salario);
                printf("Horas extras: ");
                scanf("%d", &f.horasExtras);

                fprintf(arquivo, "Nome: %s | Salario: %.2f | Horas extras: %d\n", f.nome, f.salario, f.horasExtras);
            }

            if (fclose(arquivo) != 0) {
                perror("Erro ao salvar os dados");
            } else {
                printf("\nFuncionarios cadastrados e salvos com sucesso!\n");
            }
        } else if (opcao == 2) {
            arquivo = fopen("funcionarios.txt", "r");
            if (arquivo == NULL) {
                printf("\nNenhum funcionario cadastrado.\n");
                continue;
            }

            printf("\n===== FUNCIONARIOS CADASTRADOS =====\n");
            while ((caractere = fgetc(arquivo)) != EOF) {
                putchar(caractere);
            }

            fclose(arquivo);
        } else if (opcao == 0) {
            printf("\nPrograma encerrado.\n");
        } else {
            printf("\nOpcao invalida!\n");
        }
    } while (opcao != 0);

    return 0;
}
