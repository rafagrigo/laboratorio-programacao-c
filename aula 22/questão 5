#include <stdio.h>

int main(void) {
    int numeros[5];
    int *p = numeros;
    int i;

    for (i = 0; i < 5; i++) {
        printf("Digite o %do numero inteiro: ", i + 1);
        scanf("%d", &numeros[i]);
    }

    for (i = 0; i < 5; i++) {
        printf("Elemento %d: %d\n", i + 1, *(p + i));
    }

    return 0;
}
